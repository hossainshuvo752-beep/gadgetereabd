# Required environment variables (copy to .env.local for local dev, and set
# the same two in Vercel: Settings -> Environment Variables).
# NEVER commit real values — .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_, never exposed to the browser).
# ADMIN_PASSWORD gates /admin; SERVICE_ROLE key bypasses RLS — keep secret.
ADMIN_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
