{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "outDir": ".next/tmp-crosslinks",
    "rootDir": "src",
    "incremental": false,
    "plugins": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/lib/products.ts",
    "src/lib/posts.ts",
    "src/lib/sitemapData.ts",
    "src/lib/siteUrl.ts",
    "src/lib/productDescription.ts",
    "src/lib/brand.ts"
  ]
}
